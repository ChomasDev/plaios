{
  "name": "@agent-os/core",
  "version": "0.2.0",
  "description": "Provider-neutral contracts for building an agent operating system",
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./domain": {
      "types": "./src/domain/index.ts",
      "import": "./dist/domain/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@10.28.0"
}
