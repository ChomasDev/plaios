{
  "name": "@agent-os/microfrontend",
  "version": "0.1.5",
  "description": "Shared contracts and shadcn-based UI for Agent OS microfrontends",
  "private": false,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "components.json"
  ],
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./src/components/*.tsx",
      "import": "./dist/components/*.js"
    },
    "./lib/*": {
      "types": "./src/lib/*.ts",
      "import": "./dist/lib/*.js"
    },
    "./hooks/*": {
      "types": "./src/hooks/*.ts",
      "import": "./dist/hooks/*.js"
    },
    "./styles.css": "./src/styles/globals.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "shadcn": ">=4.0.0",
    "tailwindcss": ">=4.0.0",
    "tw-animate-css": ">=1.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "19.2.4",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@10.28.0"
}
