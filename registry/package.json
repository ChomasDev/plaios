{
  "name": "@plaios/registry",
  "version": "0.1.0",
  "description": "Local PLAIOS plugin registry: Verdaccio plus the PLAIOS store UI on one port",
  "keywords": ["plaios", "registry", "verdaccio", "store", "plugins"],
  "type": "module",
  "bin": {
    "plaios-registry": "./dist/src/cli.js"
  },
  "files": ["dist", "README.md"],
  "main": "./dist/src/server.js",
  "types": "./dist/src/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/server.d.ts",
      "import": "./dist/src/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build web",
    "dev": "vite web",
    "start": "node dist/src/cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "@trpc/server": "^11.16.0",
    "verdaccio": "6.11.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/noto-sans": "^5.2.8",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-router": "^1.130.0",
    "@tanstack/router-plugin": "^1.130.0",
    "@trpc/client": "^11.16.0",
    "@types/node": "24.13.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "^7.1.7",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
