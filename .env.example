# Telegram input/output
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POLL_TIMEOUT_SECONDS=25
TELEGRAM_MAX_IMAGE_BYTES=10485760
TELEGRAM_USER_ID_MAP=

# TypeSafe / Jev orchestrator
JEV_API_KEY=
# System 1 Jev model; empty uses jev-latest
JEV_MODEL=
TYPESAFE_API_KEY=

# Codex AI provider
CODEX_API_KEY=
CODEX_MODEL=gpt-5.6-sol

# God's Eye View / Mapbox
MAPBOX_ACCESS_TOKEN=
MAPBOX_STYLE=mapbox/standard-satellite

# Home Assistant
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=

# SQLite database provider
AGENT_OS_SQLITE_PATH=.agent-os/data/agent-os.sqlite
AGENT_OS_SQLITE_FOREIGN_KEYS=true

# Dynamic control plane
AGENT_OS_REGISTRY=http://localhost:4873
AGENT_OS_CONFIG=agent-os.yaml

# Live Voice (OpenAI Realtime)
OPENAI_API_KEY=
VOICE_LIVE_MODEL=gpt-realtime
VOICE_LIVE_VOICE=marin
