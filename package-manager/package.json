{
  "name": "@agent-os/package-manager",
  "version": "0.9.1",
  "description": "CLI for creating and managing Agent OS plugin packages",
  "type": "module",
  "bin": {
    "agentos": "./dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "src"
  ],
  "main": "./dist/src/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/src/index.js"
    }
  },
  "dependencies": {
    "@agent-os/app-dynamic": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/make-cli-executable.mjs",
    "prepack": "pnpm build",
    "test": "pnpm build && node --test dist/test/**/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.28.0"
}
